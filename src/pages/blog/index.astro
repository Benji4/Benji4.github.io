---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib/posts';

const posts = await getPosts();
---

<Base title="Blog" description="Posts by Bennet Breier.">
  <h1>Blog</h1>
  {posts.length === 0 ? (
    <p class="meta">No posts yet. Follow along via <a href="/rss.xml" target="_blank" rel="noopener noreferrer">RSS</a>.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          {post.data.draft && <span class="draft-badge">draft</span>}
          <div class="meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time></div>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  )}
</Base>
